# ==========================================
# Python & UV Environments
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# ==========================================
# Django & Local Storage
# ==========================================
# Do NOT commit local databases
*.sqlite3
*.sqlite3-journal

# Do NOT commit user-uploaded PDFs / Resumes (Phase 2 & 3)
media/
uploads/

# Static files generated by collectstatic
staticfiles/

# Environment Variables (Keep secrets out of Git!)
.env
.env.*
!.env.example

# ==========================================
# Celery & Redis
# ==========================================
celerybeat-schedule
celerybeat.pid

# ==========================================
# Sentence-Transformers / HuggingFace Model Cache
# ==========================================
# Prevents committing multi-gigabyte downloaded embedding models
.cache/
huggingface/
models/
*.bin
*.safetensors
*.onnx

# ==========================================
# Testing, Linting & Coverage (pytest / ruff / mypy)
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

# ==========================================
# OS & IDE Files
# ==========================================
.DS_Store
.vscode/
.idea/
